{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exemplo da trilha B (decisao agentica) - uma linha do JSONL",
  "type": "object",
  "required": ["id", "dataset", "source_id", "sector", "task", "query", "tools", "gold_calls", "group_id", "split", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "dataset": {"type": "string"},
    "source_id": {"type": "string"},
    "sector": {"type": "string", "description": "Setor da ferramenta: juridico, saude, financeiro, agro, transversal"},
    "task": {"enum": ["tool_selection", "argument_filling", "parallel_calls", "irrelevance", "missing_params"]},
    "query": {"type": "string", "minLength": 1},
    "tools": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "description", "parameters"],
      "properties": {"name": {"type": "string"}, "description": {"type": "string"},
                     "parameters": {"type": "object", "required": ["type", "properties"], "properties": {"type": {"const": "object"}, "properties": {"type": "object"}, "required": {"type": "array", "items": {"type": "string"}}}}}}},
    "gold_calls": {"type": "array", "description": "Vazio quando nenhuma chamada e correta (irrelevance, missing_params)",
      "items": {"type": "object", "required": ["name", "arguments"],
                "properties": {"name": {"type": "string"}, "arguments": {"type": "object"},
                               "accept": {"type": "object", "description": "arg -> lista de valores alternativos aceitos"},
                               "arg_rules": {"type": "object", "description": "arg -> 'math_expr' | 'unordered'"}}}},
    "no_call_reason": {"enum": [null, "irrelevance", "missing_params"]},
    "tool_family": {"type": ["string", "null"]},
    "tool_family_seen": {"type": "boolean", "description": "false = familia reservada ao teste (generalizacao)"},
    "group_id": {"type": "string"},
    "split": {"enum": ["train", "dev", "test"]},
    "provenance": {"type": "object"}
  }
}
